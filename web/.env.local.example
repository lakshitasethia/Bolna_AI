# Real calls (optional). Without these, /desk runs simulated owners.
BOLNA_API_KEY=
# Filled in by `node scripts/bolna-setup.mjs`
BOLNA_AGENT_ID=
BOLNA_INTAKE_AGENT_ID=
# Shared secret Bolna sends to our tool endpoints. Any long random string.
BHAADA_TOOL_TOKEN=
# The https URL Bolna can reach this server on (a cloudflared tunnel or a deploy)
PUBLIC_URL=

# Real numbers for the first owners in the network, in order: "phone" or
# "Name:phone", comma-separated. On the Bolna trial these must be verified
# numbers. Owners without a number are simulated on the same agent channel.
BHAADA_OWNER_PHONES=

# Chatterbox via Bolna Custom TTS (optional): the voice name you registered
# under Settings > Integrations > TTS > Custom TTS. Empty uses Sarvam Bulbul.
BHAADA_TTS_VOICE=

# Booking alerts on Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
